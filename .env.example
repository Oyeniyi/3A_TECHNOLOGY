# 3A Technology Solutions Environment Variables Template
# Copy to .env.local for local development. Never commit .env.local (ARCH-04).

# Transactional Email Dispatch (ADR-005)
# Options: 'resend' (recommended) | 'smtp'
EMAIL_DRIVER=resend
RESEND_API_KEY=re_123456789_placeholder

# Destination Mailbox for Inbound Enquiries
NOTIFICATION_INBOX=contact@3atechnology.com.ng
CONTACT_EMAIL=contact@3atechnology.com.ng

# SMTP Fallback Driver Configuration (Optional if EMAIL_DRIVER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secret_password_here
SMTP_SECURE=false

# Canonical Site URL (Public)
NEXT_PUBLIC_SITE_URL=https://3atechnology.com.ng
